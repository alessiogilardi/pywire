# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code agent worktrees
.claude/worktrees/

# Claude Code local-only settings (per-developer, not shared)
.claude/settings.local.json

# superpowers subagent-driven-development scratch workspace
.superpowers/

# Claude Code Windows launcher bug: HOME sometimes inherited as the literal,
# unexpanded "%HOMEDRIVE%%HOMEPATH%", so a self-update writes its staging
# files here instead of the real user home. Reported upstream; ignored here
# as a stopgap until fixed.
%HOMEDRIVE%%HOMEPATH%/
